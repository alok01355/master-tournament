rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // IMPORTANT: This starter rule set is intentionally restrictive.
    // Before public launch, add trusted server-side admin claims and a Cloud Function
    // that releases room credentials only to approved registrations after match time.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.role == 'player';
    }
    match /tournaments/{id} {
      allow read: if signedIn();
      allow create, update, delete: if false; // use a trusted admin backend
    }
    match /registrations/{id} {
      allow create: if signedIn()
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.playerId == request.auth.uid;
      allow update, delete: if false; // admin review via trusted backend
    }
  }
}